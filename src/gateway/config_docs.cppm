module;

#include <meta>

export module llmgate.config_docs;

import std;
import llmgate.config;
import llmgate.doc;
import llmgate.json;
import llmgate.jsonscan;
import llmgate.members;
import llmgate.reflect;
import llmgate.text;

export namespace llmgate::config_docs {

struct naming {
    reflect::fixed_text<16> label;
    reflect::fixed_text<8> json;

    consteval naming(std::string_view const shown, std::string_view const schema) : label{shown}, json{schema} {}
};

enum class kind {
    text [[= naming{"string", "string"}]],
    flag [[= naming{"boolean", "boolean"}]],
    whole [[= naming{"integer", "integer"}]],
    real [[= naming{"number", "number"}]],
    span [[= naming{"duration", "string"}]],
    choice [[= naming{"one of", "string"}]],
    object [[= naming{"object", "object"}]],
    list [[= naming{"array of", "array"}]],
    table [[= naming{"map of", "object"}]]
};
static_assert(reflect::unique_values<kind>());

struct node {
    std::string name{};
    kind type = kind::text;
    std::string doc{};
    std::string example{};
    bool required = false;
    bool commented = false;
    bool non_negative = false;
    bool optional = false;
    json::value fallback{};
    std::vector<std::string> choices{};
    std::vector<node> members{};
    std::vector<node> element{};
};

constexpr std::size_t comment_width = 100;
constexpr std::size_t indent_width = 2;
constexpr std::string_view schema_dialect = "https://json-schema.org/draft/2020-12/schema";
constexpr std::string_view duration_pattern = "^[0-9]+(ms|s|m|h)$";
constexpr std::string_view generated_notice = "generated by llmgate --print-example from the doc and example annotations in src/gateway/config.cppm";

constexpr bool has_default(node const& item) {
    return !std::holds_alternative<std::nullptr_t>(item.fallback.data);
}

}  // namespace llmgate::config_docs

namespace llmgate::config_docs::detail {

template <class T>
constexpr node shape_of(T const& defaults);

template <class T>
struct shaper;

template <>
struct shaper<bool> {
    static constexpr node make(bool const&) { return {.type = kind::flag}; }
};

template <std::integral T>
    requires(!std::same_as<T, bool>)
struct shaper<T> {
    static constexpr node make(T const&) { return {.type = kind::whole, .non_negative = std::is_unsigned_v<T>}; }
};

template <std::floating_point T>
struct shaper<T> {
    static constexpr node make(T const&) { return {.type = kind::real}; }
};

template <>
struct shaper<std::chrono::milliseconds> {
    static constexpr node make(std::chrono::milliseconds const&) { return {.type = kind::span}; }
};

template <>
struct shaper<std::string> {
    static constexpr node make(std::string const&) { return {.type = kind::text}; }
};

template <class T>
    requires std::is_enum_v<T>
struct shaper<T> {
    static constexpr node make(T const&) {
        node made{.type = kind::choice};
        for (auto const value : reflect::enum_values<T>) {
            made.choices.emplace_back(reflect::enum_string(value));
        }
        return made;
    }
};

template <class Item>
struct shaper<std::optional<Item>> {
    static constexpr node make(std::optional<Item> const& value) {
        auto made = shape_of(value.value_or(Item{}));
        made.optional = true;
        return made;
    }
};

template <class Item>
struct shaper<std::vector<Item>> {
    static constexpr node make(std::vector<Item> const&) {
        node made{.type = kind::list};
        made.element.emplace_back(shape_of(Item{}));
        return made;
    }
};

template <class Item>
struct shaper<std::map<std::string, Item>> {
    static constexpr node make(std::map<std::string, Item> const&) {
        node made{.type = kind::table};
        made.element.emplace_back(shape_of(Item{}));
        return made;
    }
};

template <class T>
concept described_member = std::is_aggregate_v<T> && !std::is_array_v<T>;

template <std::meta::info field>
consteval std::string_view wire_name() {
    auto const renamed = reflect::annotation_of<json::key>(field);
    std::string_view const wire = renamed ? std::string_view{renamed->text} : std::meta::identifier_of(field);
    return {std::define_static_string(wire), wire.size()};
}

template <std::meta::info field, class T>
constexpr void keep_default(node& made, T const& value) {
    if (made.type == kind::object) {
        return;
    }
    made.fallback = json::to_value(value);
}

template <class T, std::meta::info field>
constexpr node member_node(T const& defaults) {
    static_assert(!reflect::has_annotation<json::flatten_t>(field), "a flattened member has no key to document");
    static_assert(reflect::has_annotation<reflect::doc>(field), "a documented member needs [[=reflect::doc{...}]]");
    constexpr auto note = reflect::annotation_of<reflect::doc>(field).value_or(reflect::doc{""});
    constexpr auto sample = reflect::annotation_of<reflect::example>(field).value_or(reflect::example{""});
    auto made = shape_of(defaults.[:field:]);
    made.name = wire_name<field>();
    made.doc = std::string_view{note.text};
    made.example = std::string_view{sample.text};
    made.required = reflect::has_annotation<json::required_t>(field);
    made.commented = reflect::has_annotation<reflect::commented_t>(field);
    keep_default<field>(made, defaults.[:field:]);
    return made;
}

template <class T, std::meta::info field>
constexpr void add_member(std::vector<node>& out, T const& defaults) {
    if constexpr (!reflect::has_annotation<json::skip_t>(field)) {
        out.emplace_back(member_node<T, field>(defaults));
    }
}

template <described_member T>
struct shaper<T> {
    static constexpr node make(T const& defaults) {
        static constexpr auto fields = std::define_static_array(std::meta::nonstatic_data_members_of(^^T, std::meta::access_context::current()));
        node made{.type = kind::object};
        template for (constexpr auto field : fields) {
            add_member<T, field>(made.members, defaults);
        }
        return made;
    }
};

template <class T>
constexpr node shape_of(T const& defaults) {
    return shaper<T>::make(defaults);
}

constexpr std::string indent_of(std::size_t const depth) {
    return std::string(depth * indent_width, ' ');
}

constexpr std::vector<std::string> split_lines(std::string_view const block) {
    std::vector<std::string> lines;
    for (auto const line : block | std::views::split('\n')) {
        lines.emplace_back(std::string_view{line});
    }
    return lines;
}

constexpr std::vector<std::string> wrapped(std::string_view const paragraph, std::size_t const width) {
    std::vector<std::string> lines;
    std::string current;
    for (auto const piece : paragraph | std::views::split(' ')) {
        std::string_view const word{piece};
        if (word.empty()) {
            continue;
        }
        if (!current.empty() && current.size() + 1 + word.size() > width) {
            lines.emplace_back(std::move(current));
            current.clear();
        }
        text::append_all(current, current.empty() ? "" : " ", word);
    }
    if (!current.empty()) {
        lines.emplace_back(std::move(current));
    }
    return lines;
}

constexpr std::vector<std::string> paragraph_lines(std::string_view const paragraph, std::size_t const width) {
    auto lines = wrapped(paragraph, width);
    if (lines.empty()) {
        lines.emplace_back();
    }
    return lines;
}

constexpr std::string comment_line(std::string_view const indent, std::string_view const line) {
    std::string out;
    text::append_all(out, indent, line.empty() ? "//" : "// ", line, "\n");
    return out;
}

constexpr std::string comment_block(std::string_view const words, std::size_t const depth) {
    std::string out;
    if (words.empty()) {
        return out;
    }
    auto const indent = indent_of(depth);
    for (auto const paragraph : words | std::views::split('\n')) {
        for (auto const& line : paragraph_lines(std::string_view{paragraph}, comment_width)) {
            out += comment_line(indent, line);
        }
    }
    return out;
}

constexpr std::string reindented(std::string_view const block, std::size_t const depth) {
    std::string out;
    auto const indent = indent_of(depth);
    bool first = true;
    for (auto const& line : split_lines(block)) {
        text::append_all(out, first ? "" : "\n", first || line.empty() ? "" : indent, line);
        first = false;
    }
    return out;
}

constexpr bool shown(node const& item) {
    return !item.example.empty() || has_default(item) || item.type == kind::object;
}

constexpr bool active(node const& item) {
    return shown(item) && !item.commented;
}

constexpr std::string members_block(std::vector<node> const& members, std::size_t depth);

constexpr std::string value_block(node const& item, std::size_t const depth) {
    if (!item.example.empty()) {
        return reindented(item.example, depth);
    }
    if (item.type == kind::object) {
        auto const inside = members_block(item.members, depth + 1);
        return inside.empty() ? "{}" : "{\n" + inside + indent_of(depth) + "}";
    }
    return json::write(item.fallback);
}

constexpr std::string commented_out(std::string_view const block, std::size_t const depth) {
    std::string out;
    auto const indent = indent_of(depth);
    for (auto const& line : split_lines(block)) {
        out += comment_line(indent, line.substr(std::min(line.size(), indent.size())));
    }
    return out;
}

constexpr std::string documented_text(node const& item) {
    std::string out = item.doc;
    bool first = true;
    for (auto const& choice : item.choices) {
        text::append_all(out, first ? " One of: " : ", ", choice);
        first = false;
    }
    return first ? out : out + ".";
}

constexpr std::string member_block(node const& item, std::size_t const depth, bool const comma) {
    std::string line;
    text::append_all(line, indent_of(depth), jsonscan::encode_string(item.name), ": ", value_block(item, depth), comma ? "," : "");
    return comment_block(documented_text(item), depth) + (item.commented ? commented_out(line, depth) : line + "\n");
}

constexpr std::size_t last_active(std::vector<node> const& members) {
    std::size_t last = members.size();
    for (std::size_t at = 0; at < members.size(); ++at) {
        last = active(members[at]) ? at : last;
    }
    return last;
}

constexpr std::string members_block(std::vector<node> const& members, std::size_t const depth) {
    std::string out;
    auto const closing = last_active(members);
    bool first = true;
    for (std::size_t at = 0; at < members.size(); ++at) {
        if (!shown(members[at])) {
            continue;
        }
        out += first || depth != 1 ? "" : "\n";
        out += member_block(members[at], depth, at < closing || members[at].commented);
        first = false;
    }
    return out;
}

constexpr std::string cell(std::string_view const words) {
    std::string out;
    for (char const letter : words) {
        out += letter == '\n' ? std::string_view{" "} : letter == '|' ? std::string_view{"\\|"} : std::string_view{&letter, 1};
    }
    return out;
}

constexpr naming naming_of(kind const which) {
    std::optional<naming> found;
    template for (constexpr auto item : std::define_static_array(std::meta::enumerators_of(^^kind))) {
        constexpr auto candidate = reflect::annotation_of<naming>(item).value();
        if (which == [:item:]) {
            found = candidate;
        }
    }
    return found.value();
}

constexpr std::string type_text(node const& item);

constexpr std::string element_text(node const& item) {
    return item.element.empty() ? std::string{"value"} : type_text(item.element.front());
}

constexpr std::string choice_text(node const& item) {
    std::string out{std::string_view{naming_of(kind::choice).label.text}};
    bool first = true;
    for (auto const& choice : item.choices) {
        text::append_all(out, first ? " `" : ", `", choice, "`");
        first = false;
    }
    return out;
}

constexpr std::string type_text(node const& item) {
    std::string out{std::string_view{naming_of(item.type).label.text}};
    if (item.type == kind::choice) {
        out = choice_text(item);
    } else if (item.type == kind::list || item.type == kind::table) {
        out += " " + element_text(item);
    }
    return out;
}

constexpr std::string default_text(node const& item) {
    if (item.required) {
        return "required";
    }
    if (has_default(item)) {
        return "`" + json::write(item.fallback) + "`";
    }
    return item.type == kind::object && !item.optional ? "-" : "none";
}

constexpr std::string row_of(node const& item, std::string_view const path) {
    std::string out;
    text::append_all(out, "| `", path, "` | ", cell(type_text(item)), " | ", cell(default_text(item)), " | ", cell(item.doc), " |\n");
    return out;
}

constexpr std::string rows_of(std::vector<node> const& members, std::string_view const prefix);

constexpr std::string element_rows(node const& item, std::string_view const path) {
    if (item.element.empty()) {
        return {};
    }
    return rows_of(item.element.front().members, std::string{path} + (item.type == kind::table ? ".<name>" : "[]"));
}

constexpr std::string rows_of(std::vector<node> const& members, std::string_view const prefix) {
    std::string out;
    for (auto const& item : members) {
        auto const path = prefix.empty() ? item.name : std::string{prefix} + "." + item.name;
        out += row_of(item, path) + rows_of(item.members, path) + element_rows(item, path);
    }
    return out;
}

constexpr json::value text_value(std::string_view const words) {
    return json::value{std::string{words}};
}

constexpr json::value schema_of(node const& item);

constexpr json::object scalar_schema(node const& item) {
    json::object out;
    out.emplace_back("type", text_value(std::string_view{naming_of(item.type).json.text}));
    if (item.type == kind::whole && item.non_negative) {
        out.emplace_back("minimum", json::value{std::int64_t{0}});
    }
    if (item.type == kind::span) {
        out.emplace_back("pattern", text_value(duration_pattern));
    }
    return out;
}

constexpr json::array choice_values(node const& item) {
    json::array out;
    for (auto const& choice : item.choices) {
        out.emplace_back(text_value(choice));
    }
    return out;
}

constexpr json::object choice_schema(node const& item) {
    auto out = scalar_schema(item);
    out.emplace_back("enum", json::value{choice_values(item)});
    return out;
}

constexpr json::object members_schema(std::vector<node> const& members) {
    json::object properties;
    json::array needed;
    for (auto const& item : members) {
        properties.emplace_back(item.name, schema_of(item));
        if (item.required) {
            needed.emplace_back(text_value(item.name));
        }
    }
    json::object out;
    out.emplace_back("type", text_value("object"));
    out.emplace_back("properties", json::value{std::move(properties)});
    out.emplace_back("required", json::value{std::move(needed)});
    out.emplace_back("additionalProperties", json::value{false});
    return out;
}

constexpr json::object container_schema(node const& item) {
    json::object out;
    auto const inner = item.element.empty() ? json::value{json::object{}} : schema_of(item.element.front());
    if (item.type == kind::list) {
        out.emplace_back("type", text_value("array"));
        out.emplace_back("items", inner);
    } else {
        out.emplace_back("type", text_value("object"));
        out.emplace_back("additionalProperties", inner);
    }
    return out;
}

constexpr json::object body_schema(node const& item) {
    switch (item.type) {
        case kind::object:
            return members_schema(item.members);
        case kind::list:
        case kind::table:
            return container_schema(item);
        case kind::choice:
            return choice_schema(item);
        default:
            return scalar_schema(item);
    }
}

constexpr json::value schema_of(node const& item) {
    auto out = body_schema(item);
    if (!item.doc.empty()) {
        out.emplace_back("description", text_value(item.doc));
    }
    if (has_default(item) && !item.required) {
        out.emplace_back("default", item.fallback);
    }
    return json::value{std::move(out)};
}

}  // namespace llmgate::config_docs::detail

export namespace llmgate::config_docs {

template <class T>
constexpr node describe() {
    return detail::shape_of(T{});
}

constexpr std::string comment_text(std::string_view const words) {
    return detail::comment_block(words, 0);
}

constexpr std::string table_cell(std::string_view const words) {
    return detail::cell(words);
}

constexpr std::string example_text(node const& root) {
    return "// " + std::string{generated_notice} + "\n{\n" + detail::members_block(root.members, 1) + "}\n";
}

constexpr std::string table_text(node const& root) {
    return "| Key | Type | Default | Description |\n|---|---|---|---|\n" + detail::rows_of(root.members, "");
}

constexpr std::string schema_text(node const& root, std::string_view const title) {
    auto out = detail::body_schema(root);
    out.insert(out.begin(), {"$schema", detail::text_value(schema_dialect)});
    out.insert(out.begin() + 1, {"title", detail::text_value(title)});
    return json::write(json::value{std::move(out)}, indent_width) + "\n";
}

constexpr void collect_keys(std::vector<std::string>& out, std::vector<node> const& members) {
    for (auto const& item : members) {
        out.emplace_back(item.name);
        collect_keys(out, item.members);
        for (auto const& inner : item.element) {
            collect_keys(out, inner.members);
        }
    }
}

constexpr std::vector<std::string> keys_of(node const& root) {
    std::vector<std::string> out;
    collect_keys(out, root.members);
    return out;
}

constexpr bool every_key_is_shown(node const& root, std::string_view const example) {
    return std::ranges::all_of(keys_of(root), [&](std::string const& name) { return example.contains(jsonscan::encode_string(name)); });
}

inline std::string gateway_example() {
    return example_text(describe<gateway::config>());
}

inline std::string gateway_table() {
    return table_text(describe<gateway::config>());
}

inline std::string gateway_schema() {
    return schema_text(describe<gateway::config>(), "llmgate configuration");
}

}  // namespace llmgate::config_docs
