// generated by llmgate --print-example from the doc and example annotations in src/gateway/config.cppm
{
  // Address the gateway listens on; point Claude Code at it with
  // ANTHROPIC_BASE_URL=http://ADDRESS/anthropic.
  "listen": "127.0.0.1:9480",

  // The single backend of an older configuration; it keeps working and acts as one provider named
  // default.
  "upstream": {
    // Base URL of the single upstream; together with the other top-level keys it acts as one provider
    // named default.
    "base_url": "https://api.githubcopilot.com",
    // Path of the Messages endpoint on the upstream.
    "messages_path": "/v1/messages",
    // A working default for this kind of provider: copilot, anthropic, chatgpt, openai_chat (a
    // chat-completions server: it sets the protocol and leaves base_url to you), bedrock (AWS Bedrock
    // Claude models: with region it fills base_url and reads the API key from AWS_BEARER_TOKEN_BEDROCK).
    // It fills base_url when that is empty and the protocol when it is left at anthropic; whatever you set
    // yourself wins. One of: none, copilot, anthropic, chatgpt, openai_chat, bedrock.
    // "preset": "chatgpt",
    // Wire protocol: anthropic (the Messages API, the default), openai_responses (OpenAI Responses,
    // translated), openai_chat (Azure OpenAI, vLLM, translated), bedrock_messages (Claude on Bedrock) or
    // bedrock_converse (other Bedrock models, translated). The messages_path default follows the protocol;
    // {model} in it is the upstream model name. One of: anthropic, openai_responses, openai_chat,
    // bedrock_messages, bedrock_converse.
    "protocol": "anthropic",
    // Extra headers sent to the upstream on every request. With a copilot login the gateway also sends
    // Editor-Version and Copilot-Integration-Id (the VS Code values) unless they are set here.
    "headers": { "Editor-Version": "vscode/1.99.0", "Copilot-Integration-Id": "vscode-chat" }
    // Limits per upstream model id, as the provider reports them (llmgate models lists them). max_tokens
    // above output_tokens is clamped; the model list carries prompt_tokens and output_tokens.
    // "limits": { "claude-sonnet-5.5": { "context_tokens": 328000, "prompt_tokens": 200000, "output_tokens": 128000 } },
    // Wire protocol of single models, keyed by upstream model id; a model not listed uses the provider's
    // protocol. A provider whose list gives supported_endpoints (a Copilot seat serves Claude models on
    // /v1/messages and GPT models on /responses) needs one entry per model that differs.
    // "model_protocols": { "gpt-6-luna": "openai_responses" },
    // Quirks of a chat-completions server (protocol openai_chat), as true or false flags:
    // use_max_completion_tokens, drop_stop_sequences, drop_sampling, drop_reasoning_effort,
    // drop_reasoning_effort_with_tools. Azure OpenAI reasoning models need the first three and the last.
    // "chat": { "use_max_completion_tokens": true, "drop_stop_sequences": true, "drop_sampling": true, "drop_reasoning_effort": false, "drop_reasoning_effort_with_tools": true },
    // AWS region of a Bedrock provider (preset bedrock): eu-central-1 gives base_url
    // https://bedrock-runtime.eu-central-1.amazonaws.com.
    // "region": "eu-central-1",
    // Settings of a Bedrock provider (protocol bedrock_messages): betas lists the anthropic-beta tokens
    // passed on.
    // "bedrock": {
    //   // anthropic-beta tokens Claude Code may pass to Bedrock; any other token is dropped and counted. Empty
    //   // means the built-in list of tokens Bedrock documents.
    //   // "betas": ["interleaved-thinking-2025-05-14", "context-management-2025-06-27"],
    //   // Settings of the Converse operation, used for models listed with protocol bedrock_converse in
    //   // model_protocols.
    //   // "converse": {
    //   //   // Models (upstream names) that take thinking on the Converse operation: Claude's thinking field is
    //   //   // passed in additionalModelRequestFields. Every other model has thinking, output_config and
    //   //   // context_management dropped and counted.
    //   //   // "thinking_models": ["anthropic.claude-sonnet-4-6-v1:0"],
    //   //   // Remove the cachePoint blocks that Claude Code's cache_control markers become, for a model that
    //   //   // refuses them.
    //   //   // "drop_cache_points": false,
    //   // },
    // },
    // Forward the client's own Authorization or x-api-key header and every anthropic-* header unchanged to
    // this provider (a Claude login or an API key held by Claude Code itself) instead of attaching a
    // gateway credential. For an Anthropic provider only; refused together with client_key_env or a
    // non-loopback listen.
    // "forward_credentials": false,
    // Models of this provider to list in Claude Code's /model picker besides the values of models; each
    // appears as claude-NAME@PROVIDER.
    // "offer": ["claude-sonnet-5-5"],
    // Labels of this provider, shown beside every model it serves in the pane, the /model picker and the
    // CLI, and used to group usage and filter targets. Each is 1 to 24 letters, digits, - or _.
    // "labels": ["work", "acme"],
    // Labels added to single models, keyed by upstream model id; a model carries its provider's labels
    // first, at most 8 in all.
    // "model_labels": { "claude-opus-5.5": ["big"] },
    // Authentication of this provider: how the secret is sent (kind, header, scheme) and where it is read
    // from (file, env). A provider with a login (copilot, chatgpt) or forward_credentials needs none;
    // static_token_env still works as the bearer secret's variable.
    // "auth": {
    //   // How the provider is authenticated: bearer (Authorization: Bearer SECRET, the default), header
    //   // (SECRET in the header named by header, after scheme when one is set) or none (no credential, for a
    //   // local model). sigv4 (AWS Signature Version 4, for Bedrock). One of: bearer, header, none, sigv4.
    //   // "kind": "header",
    //   // Header that carries the secret when kind is header.
    //   // "header": "api-key",
    //   // Text put before the secret in that header, such as Bearer; empty sends the secret alone.
    //   // "scheme": "",
    //   // Name of the environment variable that holds the secret.
    //   // "env": "PARTNER_PROD_API_KEY",
    //   // File that holds the secret (one line); keep it readable by you only. It is read before the
    //   // environment variable.
    //   // "file": "~/.config/llmgate/partner.key",
    //   // AWS profile that supplies the credentials when kind is sigv4; empty uses AWS_PROFILE, then default.
    //   // "profile": "work",
    //   // AWS service name that is signed when kind is sigv4.
    //   // "service": "bedrock",
    // },
  },

  // Claude Code expands aliases such as sonnet to full model names before it calls the gateway, so map
  // full names: client model name to upstream model name. Unknown names go through unchanged.
  "models": {
    "claude-opus-5-5": "claude-opus-5.5",
    "claude-sonnet-5-5": "claude-sonnet-5.5",
    "claude-haiku-5-5": "claude-haiku-5.5",
    "claude-haiku-4-5": "claude-haiku-4.5"
  },

  // More than one backend: name each one here. A provider with a copilot object uses the Copilot login,
  // one with static_token_env uses that variable. The keys upstream, models, copilot and
  // static_token_env stay valid and act as one provider named default.
  // "providers": {
  //   "copilot": { "base_url": "https://api.githubcopilot.com", "copilot": { "token_file": "~/.config/llmgate/copilot-token.json" },
  //                "headers": { "Editor-Version": "vscode/1.99.0", "Copilot-Integration-Id": "vscode-chat" },
  //                "models": { "claude-opus-5-5": "claude-opus-5.5" } },
  //   "anthropic": { "base_url": "https://api.anthropic.com", "static_token_env": "ANTHROPIC_UPSTREAM_KEY" }
  // },

  // Prices in US dollars per million tokens, by the model name the usage ledger records (the model of
  // the reply). The overview prices the spend of a model that is listed here; any other model's cost is
  // left unknown, never guessed.
  // "pricing": { "claude-sonnet-5.5": { "input": 3.0, "output": 15.0, "cache_read": 0.3, "cache_creation": 3.75 } },

  // Per role (opus, sonnet, haiku, fable, other) the providers to try in order. A role without a list
  // uses the other list, then every provider.
  // "routes": { "opus": ["anthropic", "copilot"], "sonnet": ["copilot", "anthropic"], "other": ["copilot"] },

  // Per request class (subagent, workflow, compaction, auxiliary) the providers or target ids
  // (claude-NAME@PROVIDER) to try in order, instead of the role's list. A target id names the model too.
  // Claude Code sends the class with CLAUDE_CODE_GATEWAY_HINT_HEADERS=1, which llmgate claude sets. Pins
  // and ids picked in /model still win.
  // "routes_by_class": { "compaction": ["claude-gpt-6-luna@codex", "copilot"] },

  // Per signal in the request itself (image: a message carries an image block; long: the body is larger
  // than long_prompt_bytes) the providers or target ids to try in order, instead of the role's list. A
  // class route (routes_by_class) wins over a signal route, and a pin or a session override wins over
  // both. The overview names the signal that routed a request.
  // "routes_by_signal": { "image": ["claude-gpt-6-sol@codex"], "long": ["copilot"] },

  // Size in bytes of a request body from which it counts as long for routes_by_signal; about four bytes
  // make a token.
  // "long_prompt_bytes": 400000,

  // Subagent types the llmgate mod registers in Claude Code, each bound to a target on any provider
  // (Claude can then delegate to it by name).
  // "agents": { "reviewer": { "target": "claude-gpt-6-sol@codex", "description": "Reviews a change as a second opinion", "prompt": "Review the change and list defects.", "tools": ["Read", "Grep"], "max_turns": 8 } },

  // Per subagent type (built-in such as Explore, or your own) the target it runs on; the mod applies it
  // when the subagent starts and it outranks the model Claude names.
  // "spawn_rules": { "Explore": "claude-gpt-6-luna@codex" },

  // A provider that fails before any response byte reaches Claude Code (connect error, no response head
  // in time, 5xx, 429) is retried on the next one of the role's list; after failures consecutive
  // failures it is skipped for cooldown.
  "fallback": {
    // Consecutive failures after which a provider is skipped.
    "failures": 3,
    // How long a skipped provider stays skipped; then one request probes it.
    "cooldown": "30s"
  },

  // Time limits of the gateway.
  "time": {
    // How long a connect to a provider may take. A duration is a number with the unit ms, s, m or h.
    "connect": "10s",
    // How long a provider may take to send the response head before the attempt counts as failed and the
    // next provider is tried.
    "response_head": "2m",
    // How long a streaming response may stay silent before the gateway cuts it with an error event, so
    // that the client can retry. Anthropic servers send a ping every few seconds, so a silence of two
    // minutes is a stall; raise it for a provider that streams nothing while it reasons.
    "stream_idle": "2m",
    // How long a stop (SIGINT or SIGTERM) lets running requests finish; a second signal exits at once.
    "drain": "10s"
  },

  // TLS key exchange groups offered to the providers. One of: post_quantum_required,
  // post_quantum_preferred, classical_only.
  "tls_groups": "post_quantum_preferred",

  // Proxy and certificate authorities for the connections llmgate opens to providers.
  // "network": {
  //   // Proxy for every outbound connection to a provider: an http:// URL, with user:password@ in front of
  //   // the host for a proxy that asks for credentials. Empty uses HTTPS_PROXY, https_proxy or ALL_PROXY
  //   // from the environment. Addresses on this machine are never proxied.
  //   // "proxy": "http://proxy.corp.example:3128",
  //   // Hosts that skip the proxy: a name (with or without a leading dot, it matches its subdomains too), an
  //   // IP address, a CIDR range, host:port, or *. Empty uses NO_PROXY or no_proxy from the environment.
  //   // "no_proxy": ["internal.corp.example", "10.0.0.0/8"],
  //   // PEM file of extra trusted certificate authorities, for a network that inspects TLS with its own
  //   // authority.
  //   // "ca_file": "~/.config/llmgate/corporate-ca.pem",
  //   // Also trust the authorities of the operating system (on macOS the system and system-root keychains;
  //   // on Linux the usual bundle paths are always read). SSL_CERT_FILE and SSL_CERT_DIR are always
  //   // honoured.
  //   "system_roots": true
  // },

  // GitHub Copilot device login of the default provider; run llmgate login once.
  "copilot": {
    // File that holds the GitHub OAuth token; run llmgate login once to write it.
    "token_file": "~/.config/llmgate/copilot-token.json",
    // OAuth client id of the device login; the default is the one the VS Code Copilot extension uses.
    "client_id": "Iv1.b507a08c87ecfe98",
    // GitHub web address used by the device login.
    "github_url": "https://github.com",
    // GitHub API address that exchanges the OAuth token for a Copilot token.
    "api_url": "https://api.github.com"
    // Time between polls of the device login; absent means the interval GitHub names.
    // "poll_interval": "5s",
  },

  // ChatGPT plan sign-in of this provider (OpenAI's documented token sharing for open-source tools);
  // used instead of static_token_env, with protocol openai_responses.
  "chatgpt": {
    // File that holds the ChatGPT sign-in tokens (created with mode 0600); run llmgate login --provider
    // NAME once to write it.
    "token_file": "~/.config/llmgate/chatgpt-token.json",
    // Address of the OpenAI sign-in service.
    "issuer": "https://auth.openai.com",
    // Port on 127.0.0.1 that receives the browser's callback during the sign-in.
    "callback_port": 1455,
    // Name OpenAI shows the user when this tool is registered at the first sign-in.
    "agent_name": "llmgate"
  },

  // Name of the environment variable that holds the API key of the default provider.
  // "static_token_env": "ANTHROPIC_UPSTREAM_KEY",

  // Name of the environment variable that holds the key clients must send; required when listen is not a
  // loopback address.
  // "client_key_env": "LLMGATE_CLIENT_KEY",

  // Host names, besides the listen address, accepted in the Host header of a request.
  // "allowed_hosts": ["gateway.internal:9480"],

  // What llmgate claude and llmgate env give Claude Code: model names per role, context window and
  // profile.
  "claude": {
    // Model name Claude Code uses for the opus role.
    "opus": "claude-opus-5-5",
    // Model name Claude Code uses for the sonnet role.
    "sonnet": "claude-sonnet-5-5",
    // Model name Claude Code uses for the haiku role.
    "haiku": "claude-haiku-5-5",
    // Model name Claude Code uses for the fable role.
    "fable": "claude-fable-5-1",
    // Model Claude Code starts with: a model name or an alias such as opusplan.
    "model": "opusplan",
    // Context window Claude Code assumes, in tokens; it also sets the auto-compact window.
    "context_tokens": 180000,
    // Directory of the separate Claude Code profile that llmgate claude uses.
    "profile_dir": "~/.claude-llmgate",
    // Effort level written to the profile when it has none.
    "effort": "medium",
    // Whether Claude Code keeps its telemetry on; off by default.
    "telemetry": false,
    // Credential Claude Code presents to the gateway: gateway sends the gateway key (or a placeholder) as
    // ANTHROPIC_AUTH_TOKEN; login sends none, so Claude Code keeps using its own saved login or API key,
    // which a provider with forward_credentials passes on. One of: gateway, login.
    "credential": "gateway",
    // Whether llmgate claude loads the llmgate mod (the /llmgate pane and status entry) into Claude Code;
    // the mod ships inside the binary.
    "mod": true
  },

  // Usage ledger and token budgets.
  "usage": {
    // File that receives one line per request; the gateway reads it back at start-up.
    "ledger_file": "~/.local/state/llmgate/usage.jsonl",
    // Token budgets; 0 means no limit, and counted tokens are input + output + cache writes.
    "budget": {
      // Tokens allowed per UTC day; 0 means no limit.
      "daily_tokens": 0,
      // Tokens allowed per UTC month; 0 means no limit.
      "monthly_tokens": 0,
      // Percent of a budget after which the status line turns to high.
      "warn_percent": 80
    }
  },

  // Debugging aids that are off by default.
  "debug": {
    // File that receives one JSON line per request with the request and reply bodies and the headers
    // (credentials replaced by <redacted>), for finding out what a misbehaving model sent. The file holds
    // your conversations: it is created with mode 0600, is off while this is empty, and stops growing at
    // capture_limit_mib.
    // "capture_file": "~/.local/state/llmgate/capture.jsonl",
    // Size in MiB at which the capture file stops growing.
    "capture_limit_mib": 256
  }
}
