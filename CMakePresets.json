{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "fuzz",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "afl-g++-fast",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "fuzz_http_parser",
        "fuzz_sse_parser"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "host-network",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "network"
        }
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    }
  ]
}
