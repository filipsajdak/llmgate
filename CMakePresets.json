{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release-macos",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/release-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENSSL_USE_STATIC_LIBS": "ON",
        "LLMGATE_STATIC_RUNTIME": "ON"
      }
    },
    {
      "name": "linux",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "release-linux",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/release-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENSSL_USE_STATIC_LIBS": "ON",
        "LLMGATE_STATIC_RUNTIME": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "fuzz",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "afl-g++-fast",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "coverage",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage -O0 -Wno-error=coverage-invalid-line-number",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "asan",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fsanitize=float-divide-by-zero,float-cast-overflow,pointer-compare,pointer-subtract -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fsanitize=float-divide-by-zero,float-cast-overflow,pointer-compare,pointer-subtract -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fsanitize=float-divide-by-zero,float-cast-overflow,pointer-compare,pointer-subtract -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fsanitize=float-divide-by-zero,float-cast-overflow,pointer-compare,pointer-subtract -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -fno-sanitize-recover=all -D_GLIBCXX_ASSERTIONS -ftrivial-auto-var-init=pattern -g -O1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "targets": ["llmgate"]
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "targets": ["llmgate"]
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "fuzz_http_parser",
        "fuzz_sse_parser",
        "fuzz_jsonscan",
        "fuzz_guard",
        "fuzz_json",
        "fuzz_routing",
        "fuzz_settings",
        "fuzz_launcher",
        "fuzz_usage",
        "fuzz_schedule"
      ]
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "host-network",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "network"
        }
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1:detect_invalid_pointer_pairs=2:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1:detect_invalid_pointer_pairs=2:halt_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "filter": {
        "exclude": {
          "label": "network"
        }
      }
    }
  ]
}
